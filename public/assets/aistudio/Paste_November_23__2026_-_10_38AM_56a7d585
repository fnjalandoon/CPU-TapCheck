function apiToday(token, code) {
  return guard_(token, {}, function (u) {
    var cls = classFor_(u, code);
    if (!cls) return { ok: false, msg: 'Class not found.' };
    var tz = tz_();
    var n = now_(tz);
    var s = session_(cls, n, tz);
    var roster = table_('Roster').filter(function (r) { return r.Code === String(code); });
    var att = table_('Attendance').filter(function (r) { return r.Code === String(code) && r.Date === n.date; });

    var seen = {};
    var present = att.map(function (r) {
      seen[normId_(r.ID)] = true;
      return { id: r.ID, name: r.Name, time: to12_(r.Time), status: r.Status, method: r.Method, sort: r.Time };
    }).sort(function (a, b) { return a.sort < b.sort ? -1 : 1; });
    var absent = roster.filter(function (r) { return !seen[normId_(r.ID)]; })
      .map(function (r) { return { id: r.ID, name: r.Name }; });

    return {
      ok: true, subject: cls.Subject, dateLabel: n.label, isDay: s.isDay, open: s.open,
      present: present, absent: absent,
      counts: {
        total: roster.length,
        present: present.filter(function (p) { return p.status === 'Present'; }).length,
        late: present.filter(function (p) { return p.status === 'Late'; }).length,
        absent: absent.length
      }
    };
  });
}

function apiTotals(token, code) {
  return guard_(token, {}, function (u) {
    var cls = classFor_(u, code);
    if (!cls) return { ok: false, msg: 'Class not found.' };
    var threshold = num_(settings_().Threshold, DEFAULT_THRESHOLD);
    var roster = table_('Roster').filter(function (r) { return r.Code === String(code); });
    var att = table_('Attendance').filter(function (r) { return r.Code === String(code); });
    var dates = {}, perId = {};
    att.forEach(function (r) {
      dates[r.Date] = true;
      var id = normId_(r.ID);
      (perId[id] = perId[id] || {})[r.Date] = true;
    });
    var held = Object.keys(dates).length;
    var rows = roster.map(function (r) {
      var got = Object.keys(perId[normId_(r.ID)] || {}).length;
      return { id: r.ID, name: r.Name, attended: got, pct: held ? Math.round(got * 1000 / held) / 10 : null };
    });
    return { ok: true, held: held, threshold: threshold, rows: rows };
  });
}


// Full report: every student against every meeting date (for the Excel download).
function apiReport(token, code) {
  return guard_(token, {}, function (u) {
    var cls = classFor_(u, code);
    if (!cls) return { ok: false, msg: 'Class not found.' };
    var roster = table_('Roster').filter(function (r) { return r.Code === String(code); });
    var att = table_('Attendance').filter(function (r) { return r.Code === String(code); });
    var dset = {}, per = {};
    att.forEach(function (r) {
      dset[r.Date] = true;
      var id = normId_(r.ID);
      (per[id] = per[id] || {})[r.Date] = r.Status;
    });
    var dates = Object.keys(dset).sort();
    var th = num_(settings_().Threshold, DEFAULT_THRESHOLD);
    var rows = roster.map(function (r) {
      var m = per[normId_(r.ID)] || {};
      var marks = dates.map(function (d) { return m[d] === 'Late' ? 'L' : (m[d] ? 'P' : ''); });
      var got = marks.filter(function (x) { return x; }).length;
      return { id: r.ID, name: r.Name, course: r.CourseYear, marks: marks, attended: got,
               late: marks.filter(function (x) { return x === 'L'; }).length,
               pct: dates.length ? Math.round(got * 1000 / dates.length) / 10 : null };
    }).sort(function (a, b) { return a.name < b.name ? -1 : (a.name > b.name ? 1 : 0); });
    return { ok: true, subject: cls.Subject, schedule: scheduleText_(cls), code: cls.Code, threshold: th, dates: dates, rows: rows };
  });
}

