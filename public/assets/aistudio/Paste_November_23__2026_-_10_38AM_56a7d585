function apiAddTeacher(token, username, name) {
  return guard_(token, { admin: true, write: true }, function (u) {
    username = String(username || '').trim().toLowerCase();
    name = String(name || '').trim().replace(/\s+/g, ' ').slice(0, 80);
    if (!/^[a-z0-9][a-z0-9._-]{2,24}$/.test(username)) {
      return { ok: false, msg: 'Username: 3 to 25 letters or numbers (no spaces), for example maria.santos' };
    }
    if (!name) return { ok: false, msg: 'Please enter the teacher\'s name.' };
    if (findTeacher_(username)) return { ok: false, msg: 'That username is already taken.' };
    var key = tempKey_(), salt = newSalt_();
    var row = { Username: username, Name: name, Role: 'teacher', Salt: salt, KeyHash: hash_(salt, key),
                MustChange: 'yes', Active: 'yes', Created: now_(tz_()).date };
    var sh = sheet_('Teachers');
    sh.getRange(sh.getLastRow() + 1, 1, 1, TEACHER_HEAD.length).setNumberFormat('@').setValues([toArr_(TEACHER_HEAD, row)]);
    return { ok: true, username: username, name: name, tempKey: key };
  });
}

function apiResetKey(token, username) {
  return guard_(token, { admin: true, write: true }, function (u) {
    var t = findTeacher_(String(username || '').toLowerCase());
